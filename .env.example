DISCORD_TOKEN=여기에_디스코드_봇_토큰_입력
CHECK_INTERVAL_SECONDS=10
DATABASE_PATH=uptime.db
# 직접 조회가 실패할 때 외부 서비스(mcsrvstat.us)로 확인합니다. 도메인만 전송하며 IP는 보내지 않습니다. 끄려면 false
EXTERNAL_FALLBACK=true
# !H전적: developer.hypixel.net에서 발급
HYPIXEL_API_KEY=
# !V전적: HenrikDev 디스코드에서 발급 (https://api.henrikdev.xyz/dashboard/)
HENRIK_API_KEY=
# 봇 관리자 디스코드 사용자 ID (쉼표로 여러 명). £servers를 쓸 수 있고 오류 알림 DM을 받습니다.
# 비워 두면 개발자 포털에서 봇을 만든 계정이 관리자입니다.
BOT_OWNER_IDS=
# !올리기: S3 호환 저장소 (README의 "파일 저장소" 참고, Backblaze B2 추천). 비워 두면 파일 명령어만 꺼집니다.
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
# 공개 버킷일 때만 공개 주소. 비우면 7일짜리 서명된 링크를 씁니다.
STORAGE_PUBLIC_URL=
# 서버당 / 전체 저장 한도와 파일당 최대 크기 (MB). B2·R2 무료는 10GB입니다.
FILE_GUILD_QUOTA_MB=10240
FILE_TOTAL_QUOTA_MB=10240
FILE_MAX_MB=500
